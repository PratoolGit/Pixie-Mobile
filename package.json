{
  "name": "pixie-companion",
  "productName": "Pixie",
  "version": "1.0.0",
  "description": "Pixie - a sweet, spicy, cute anime desktop companion that sees your gestures, hears your voice and runs agentic tasks.",
  "main": "main.js",
  "author": "Pixie",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/fetch-vision.js",
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "mobile:www": "node scripts/build-www.js",
    "mobile:android": "node scripts/build-www.js && npx cap sync android"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "@mediapipe/tasks-vision": "0.10.14",
    "@capacitor/core": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/android": "^6.1.2"
  },
  "build": {
    "appId": "com.pixie.companion",
    "productName": "Pixie",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pixie",
      "artifactName": "Pixie-Setup-${version}.${ext}"
    }
  }
}